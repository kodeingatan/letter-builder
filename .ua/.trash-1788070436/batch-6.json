          "SE-GT-002: Archive \u2192 removed from relation selectors",
          "SE-GT-003: Delete column with data \u2192 data loss (blocked)",
          "SE-GT-004: Change column type \u2192 data incompatibility",
          "SE-GT-005: Add required column \u2192 existing records need defaults"
        ]
      }
