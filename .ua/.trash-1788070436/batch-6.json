      "id": "concept:GlobalTableLifecycle",
      "type": "concept",
      "name": "GlobalTable Lifecycle",
      "filePath": "docs/specs/01-global-table/domain.md",
      "summary": "State machine for GlobalTable: Draft (freely modifiable) \u2192 Published (available for Components, restricted changes) \u2192 Archived (no new references, data preserved). Supports unpublish back to Draft.",
      "tags": [
        "state-machine",
        "lifecycle",
        "status-transitions"
      ],
      "metadata": {
        "transitions": [
          "Draft \u2192 Published (at least 1 column, valid names)",
          "Published \u2192 Draft (unpublish allowed)",
          "Published \u2192 Archived (no active workflow references)",
          "Archived \u2192 Published (structure valid)"
        ]
      }
    },
